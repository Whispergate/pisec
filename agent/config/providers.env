# pisec provider keys: uncomment the provider(s) you use and paste the key.
# Tracked as a template: keep real keys out of commits with
#   git update-index --skip-worktree agent/config/providers.env
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# For a custom endpoint in models.json, use the variable its apiKey references, e.g.:
# LITELLM_API_KEY=
